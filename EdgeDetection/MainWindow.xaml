<Window x:Class="EdgeDetection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EdgeDetection"
        mc:Ignorable="d"
        Title="EdgeDetection" Height="408" Width="444">
    <Grid Margin="0,0,10,-6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="29*"/>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="305*"/>
            <ColumnDefinition Width="49*"/>
        </Grid.ColumnDefinitions>
        <Image x:Name="imageInput" HorizontalAlignment="Left" Height="200" Margin="4,92,0,0" VerticalAlignment="Top" Width="200" Grid.ColumnSpan="4" Grid.Column="1"/>
        <Image x:Name="imageOutput" HorizontalAlignment="Left" Height="200" Margin="130,92,0,0" VerticalAlignment="Top" Width="200" Grid.Column="4" Grid.ColumnSpan="2"/>
        <Button x:Name="buttonImport" Content="Import" HorizontalAlignment="Left" Margin="3,307,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.606,0.979" Click="buttonImport_Click" Grid.ColumnSpan="2" Grid.Column="2" Height="20" Width="40"/>
        <Button x:Name="buttonApply" Content="Apply" HorizontalAlignment="Left" Margin="55,333,0,0" VerticalAlignment="Top" Click="buttonApply_Click" RenderTransformOrigin="0.651,1.167" Grid.Column="4" Height="20" Width="35"/>
        <ComboBox x:Name="comboBoxEdgeDetectionSelection" HorizontalAlignment="Left" Margin="3,332,0,0" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.5,0.5" SelectedIndex="0" Grid.ColumnSpan="3" Grid.Column="2" Height="22">
            <ComboBoxItem Content="Sobel"/>
            <ComboBoxItem Content="Prewitt"/>
        </ComboBox>

    </Grid>
</Window>
