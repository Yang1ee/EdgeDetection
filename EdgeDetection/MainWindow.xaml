<Window x:Class="EdgeDetection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EdgeDetection"
        mc:Ignorable="d"
        Title="EdgeDetection" Height="600" Width="700">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Operator Selection -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Edge Operator:" VerticalAlignment="Center" Width="100"/>
            <ComboBox x:Name="OperatorComboBox" Width="150"  SelectedIndex="0">
                <ComboBoxItem Content="Sobel" />
                <ComboBoxItem Content="Prewitt" />
            </ComboBox>
        </StackPanel>

        <!-- Image Selection -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Input Image:" VerticalAlignment="Center" Width="100"/>
            <TextBox x:Name="ImagePathTextBox" Width="400" IsReadOnly="True"/>
            <Button Content="Browse..." Click="BrowseButton_Click" Margin="5,0,0,0"/>
        </StackPanel>

        <!-- Run Button -->
        <Button x:Name="RunButton" Content="Run Edge Detection"
                Grid.Row="2" Width="200" Height="30"
                HorizontalAlignment="Center"
                Click="RunButton_Click" />

        <!-- Output Label -->
        <TextBlock x:Name="OutputTextBlock"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   Text=""
                   TextWrapping="Wrap"
                   Foreground="DarkGreen"
                   HorizontalAlignment="Center"/>

        <!-- Image Previews -->
        <Grid Grid.Row="4" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Input Preview -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <TextBlock Text="Input Image" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <Border BorderBrush="Gray" BorderThickness="1">
                    <Image x:Name="InputImagePreview" Width="300" Height="300" Stretch="Uniform"/>
                </Border>
            </StackPanel>

            <!-- Output Preview -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="Output Image" FontWeight="Bold" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <Border BorderBrush="Gray" BorderThickness="1">
                    <Image x:Name="OutputImagePreview" Width="300" Height="300" Stretch="Uniform"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
